#!/usr/bin/env python3
"""Keep the bench USB-recovery image alive, identified by balloon USB serial.

Normal flight firmware does not require heartbeats. For the diagnostic image,
closing this monitor or losing USB replies returns the balloon to ROM BOOTSEL.
This tool never flashes hardware and never opens the ground-station port.
"""
import argparse
import datetime
from pathlib import Path
import sys
import time

import serial
from serial.tools import list_ports


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--serial-number', default='5303284748B66A1C')
    parser.add_argument('--log', required=True)
    parser.add_argument('--duration', type=float, default=0,
                        help='seconds; zero keeps monitoring until interrupted')
    args = parser.parse_args()
    # picotool exits before the application USB interface finishes enumerating.
    deadline = time.monotonic() + 6
    while True:
        ports = [p for p in list_ports.comports()
                 if p.serial_number == args.serial_number]
        if ports or time.monotonic() >= deadline:
            break
        time.sleep(.1)
    if len(ports) != 1:
        print('Balloon application USB port not uniquely available. '
              'Check whether the board is in BOOTSEL.', file=sys.stderr)
        return 1
    path = Path(args.log)
    path.parent.mkdir(parents=True, exist_ok=True)
    started = last_reply = time.monotonic()
    last_sent = 0
    replies = 0
    pending = b''
    try:
        with serial.Serial(ports[0].device, 115200, timeout=.1,
                           write_timeout=.3, exclusive=True) as device, path.open('a') as log:
            print(f'Balloon {args.serial_number} on {device.port}; log={path}', flush=True)
            while not args.duration or time.monotonic() - started < args.duration:
                now = time.monotonic()
                if now - last_sent >= .5:
                    device.write(b'k')
                    last_sent = now
                pending += device.read(4096)
                while b'\n' in pending:
                    line, pending = pending.split(b'\n', 1)
                    text = line.decode('ascii', errors='replace').rstrip('\r')
                    stamp = datetime.datetime.now(datetime.timezone.utc).isoformat()
                    log.write(f'{stamp} {text}\n')
                    if text.startswith('USB_HEARTBEAT'):
                        last_reply = time.monotonic()
                        replies += 1
                    if text.startswith(('SPLIT_HOST', 'RADIO_READY', 'LINK_START')):
                        print(text, flush=True)
                log.flush()
                # Bound a malformed/incomplete USB line without growing forever.
                if len(pending) > 8192:
                    log.write('MONITOR discarded overlong unterminated line\n')
                    pending = b''
                if time.monotonic() - last_reply > 4:
                    print('USB heartbeat replies lost; stopping writes. '
                          'The diagnostic watchdog should return to BOOTSEL.', flush=True)
                    return 2
    except KeyboardInterrupt:
        pass
    except (serial.SerialException, OSError) as error:
        print(f'USB monitor stopped: {error}', file=sys.stderr)
        return 2
    print(f'Monitor closed after {replies} heartbeat replies. '
          'Diagnostic firmware will return to BOOTSEL when its watchdog expires.', flush=True)
    return 0


if __name__ == '__main__':
    sys.exit(main())
